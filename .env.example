# ---- Backend: copy to backend/.env ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:1234@localhost:5432/notifications?schema=public
REDIS_URL=redis://localhost:6379

# Seed
SEED_USER_COUNT=100000

# Processing
RECIPIENT_BATCH_SIZE=1000
NOTIFICATION_WORKER_CONCURRENCY=20
MAX_NOTIFICATION_RETRIES=3
PROCESSING_TIMEOUT_SECONDS=300
RECONCILE_INTERVAL_SECONDS=5

# Tests (isolated schema in the same database)
TEST_DATABASE_URL=postgresql://postgres:1234@localhost:5432/notifications?schema=test

# ---- Frontend: optional, copy to frontend/.env.local ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api